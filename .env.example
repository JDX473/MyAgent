# 复制本文件为 .env 并填入真实值（.env 已被 git 忽略，不会上传）
# DeepSeek API Key（必填）：https://platform.deepseek.com
DEEPSEEK_API_KEY=

# 可选：切换模型（默认 deepseek-v4-flash）
# DEEPSEEK_MODEL=deepseek-v4-pro

# 博查 Bocha API Key（websearch 工具需要）：https://open.bocha.cn
# BOCHA_API_KEY=

# 可选：博查 API 地址（默认 https://api.bocha.cn/v1）
# BOCHA_BASE_URL=https://api.bocha.cn/v1

# 可选：钩子调用标记调试日志（1/true/yes/on 开启）
# AGENT_DEBUG=1

# 可选：每条用户消息的单段轮数预算（默认 20）
# AGENT_MAX_STEPS=20

# 可选：自动续跑段数（总硬上限 = 单段预算 × 段数；设 0 关闭自动续跑）
# AGENT_MAX_TOTAL_STEPS=3
